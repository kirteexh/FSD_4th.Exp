{
  "info": {
    "name": "Event Management API",
    "description": "RESTful API for Event Management System - FSD Experiment 4",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get All Events",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/events",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "events"]
        },
        "description": "Retrieve all events from the database. Returns 200 OK with array of events."
      },
      "response": []
    },
    {
      "name": "Get Event by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/events/1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "events", "1"]
        },
        "description": "Retrieve a specific event by ID. Returns 200 OK if found, 404 Not Found if event doesn't exist."
      },
      "response": []
    },
    {
      "name": "Create New Event",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Music Festival 2024\",\n  \"date\": \"2024-12-20\",\n  \"location\": \"City Park\",\n  \"description\": \"Annual music festival with live performances\",\n  \"capacity\": 1000,\n  \"registered\": 0\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/events",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "events"]
        },
        "description": "Create a new event. Requires name, date, and location. Returns 201 Created on success, 400 Bad Request if validation fails."
      },
      "response": []
    },
    {
      "name": "Update Event",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"registered\": 300\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/events/1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "events", "1"]
        },
        "description": "Update an existing event. Can update any field. Returns 200 OK on success, 404 Not Found if event doesn't exist."
      },
      "response": []
    },
    {
      "name": "Delete Event",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/events/1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "events", "1"]
        },
        "description": "Delete an event by ID. Returns 200 OK with deleted event data on success, 404 Not Found if event doesn't exist."
      },
      "response": []
    },
    {
      "name": "Error Test - Invalid ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/events/999",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "events", "999"]
        },
        "description": "Test error handling with non-existent ID. Should return 404 Not Found."
      },
      "response": []
    },
    {
      "name": "Error Test - Missing Fields",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Incomplete Event\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/events",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "events"]
        },
        "description": "Test validation by sending incomplete data. Should return 400 Bad Request."
      },
      "response": []
    },
